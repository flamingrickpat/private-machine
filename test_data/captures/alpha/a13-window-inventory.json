{
  "scope": "Actual M3-41 smelt returned two raw iron and one ingot, then incorrectly reported missing after successful recovery. Open-window player slots in the Node check are explicit projections.",
  "sources": {
    "journal": {
      "path": "C:\\source\\pm\\pm_next_v2\\.runtime\\alpha\\a13-m3-20\\app\\managed_tasks\\ad5f4b4094a14bf6bcfe9caeead2770a\\attempts\\actor-0028\\scratch\\actor-journal.jsonl",
      "sha256": "6da643770285f0cc87e1416f18755fddcbe98c5c4145d04ff37b3e1b0e9e7282"
    },
    "inventory_library": {
      "path": "C:\\source\\pm\\pm-minecraft\\body\\node_modules\\mineflayer\\lib\\plugins\\inventory.js",
      "sha256": "03e916b3b1ff72a4d625d888a3d1e462f82c00b388d50af8f2b862fc7e63a6bb"
    }
  },
  "library_copy_excerpt": [
    "  function closeWindow (window) {",
    "    bot._client.write('close_window', {",
    "      windowId: window.id",
    "    })",
    "    copyInventory(window)",
    "    lastClosedWindow = window",
    "    bot.currentWindow = null",
    "    bot.emit('windowClose', window)",
    "  }",
    "",
    "  function copyInventory (window) {",
    "    const slotOffset = window.inventoryStart - bot.inventory.inventoryStart",
    "    for (let i = window.inventoryStart; i < window.inventoryEnd; i++) {",
    "      const item = window.slots[i]",
    "      const slot = i - slotOffset",
    "      if (item) {",
    "        item.slot = slot",
    "      }",
    "      if (!Item.equal(bot.inventory.slots[slot], item, true)) bot.inventory.updateSlot(slot, item)",
    "    }",
    "  }"
  ],

{
  "schema": 1,
  "scope": "Original rejected world coordinates and independent observed cells. No inference or acceptance.",
  "tool_schema": {
    "name": "minecraft_inspect_block",
    "description": "Examine one block cell: its identity, its six neighbors, its drops.\n\nThe microscope. Use before mining something risky, before building next\nto something, or whenever a find/mine/build result surprised you. It\nanswers: what exactly is at this cell, is it exposed (and on which\nfaces), what drops when harvested, which tool is fastest, and can my\nCURRENT held item get the drops at all.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "description": "The cell to inspect.",
          "properties": {
            "x": {
              "description": "East-west axis. +X = east.",
              "type": "integer"
            },
            "y": {
              "description": "Vertical axis. +Y = up. Sea level is ~63.",
              "type": "integer"
            },
            "z": {
              "description": "North-south axis. +Z = south.",
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "type": "object"
        },
        "include_image": {
          "default": false,
          "type": "boolean",
          "description": "Attach a screenshot of the cell (default False)."
        }
      },
      "required": [
        "position"
      ],
      "type": "object"
    }
  },
